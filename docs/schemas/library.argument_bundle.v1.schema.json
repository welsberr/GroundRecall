{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundrecall.example/schemas/library.argument_bundle.v1.schema.json",
  "title": "Library Argument Bundle v1",
  "description": "Provenance-first interchange contract for argument ingestion. This schema describes candidates and reviewed records; it does not perform extraction or lineage inference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "created_at",
    "release_level",
    "review_state",
    "knowledge_basis_manifest",
    "sources",
    "documents",
    "versions",
    "spans",
    "claim_instances",
    "canonical_claim_references",
    "argument_relations",
    "citation_assertions",
    "lineage_candidates",
    "coverage_audits",
    "review_receipts"
  ],
  "properties": {
    "schema_version": { "const": "library.argument_bundle.v1" },
    "bundle_id": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/dateTime" },
    "release_level": { "$ref": "#/$defs/releaseLevel" },
    "review_state": { "$ref": "#/$defs/reviewState" },
    "knowledge_basis_manifest": { "$ref": "#/$defs/knowledgeBasisManifest" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "documents": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "versions": { "type": "array", "items": { "$ref": "#/$defs/version" } },
    "spans": { "type": "array", "items": { "$ref": "#/$defs/span" } },
    "claim_instances": { "type": "array", "items": { "$ref": "#/$defs/claimInstance" } },
    "canonical_claim_references": { "type": "array", "items": { "$ref": "#/$defs/canonicalClaimReference" } },
    "argument_relations": { "type": "array", "items": { "$ref": "#/$defs/argumentRelation" } },
    "citation_assertions": { "type": "array", "items": { "$ref": "#/$defs/citationAssertion" } },
    "lineage_candidates": { "type": "array", "items": { "$ref": "#/$defs/lineageCandidate" } },
    "coverage_audits": { "type": "array", "items": { "$ref": "#/$defs/coverageAudit" } },
    "review_receipts": { "type": "array", "items": { "$ref": "#/$defs/reviewReceipt" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "hash": { "type": "string", "pattern": "^[A-Za-z0-9:_-]+$" },
    "releaseLevel": { "type": "string", "enum": ["private", "public"] },
    "reviewState": { "type": "string", "enum": ["draft", "triaged", "reviewed", "promoted", "public", "private", "verified", "deprecated"] },
    "sourceKind": { "type": "string", "enum": ["text", "audio", "video", "web_page", "book", "article", "multimedia", "other"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "captured_at"],
      "properties": {
        "origin": { "type": "string", "enum": ["human", "import", "deterministic", "model", "review"] },
        "captured_at": { "$ref": "#/$defs/dateTime" },
        "agent_or_tool": { "type": "string", "minLength": 1 },
        "run_id": { "$ref": "#/$defs/id" },
        "input_hash": { "$ref": "#/$defs/hash" },
        "notes": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_kind", "title", "canonical_uri", "release_level", "review_state", "provenance"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "source_kind": { "$ref": "#/$defs/sourceKind" },
        "title": { "type": "string", "minLength": 1 },
        "canonical_uri": { "type": "string", "format": "uri" },
        "publisher": { "type": "string" },
        "collection_label": { "type": "string" },
        "source_hash": { "$ref": "#/$defs/hash" },
        "published_at": { "type": "string", "format": "date" },
        "accessed_at": { "$ref": "#/$defs/dateTime" },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "rights_note": { "type": "string" },
        "release_level": { "$ref": "#/$defs/releaseLevel" },
        "review_state": { "$ref": "#/$defs/reviewState" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "source_id", "document_kind", "release_level", "review_state"],
      "properties": {
        "document_id": { "$ref": "#/$defs/id" },
        "source_id": { "$ref": "#/$defs/id" },
        "document_kind": { "type": "string", "enum": ["article", "transcript", "chapter", "post", "recording", "video", "web_page", "other"] },
        "language": { "type": "string" },
        "release_level": { "$ref": "#/$defs/releaseLevel" },
        "review_state": { "$ref": "#/$defs/reviewState" }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_id", "document_id", "content_hash", "captured_at", "release_level", "review_state"],
      "properties": {
        "version_id": { "$ref": "#/$defs/id" },
        "document_id": { "$ref": "#/$defs/id" },
        "content_hash": { "$ref": "#/$defs/hash" },
        "captured_at": { "$ref": "#/$defs/dateTime" },
        "normalization": { "type": "string" },
        "tool": { "type": "string" },
        "release_level": { "$ref": "#/$defs/releaseLevel" },
        "review_state": { "$ref": "#/$defs/reviewState" }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_id", "version_id", "locator_kind", "start", "end", "release_level", "review_state"],
      "properties": {
        "span_id": { "$ref": "#/$defs/id" },
        "version_id": { "$ref": "#/$defs/id" },
        "locator_kind": { "type": "string", "enum": ["character", "line", "page", "timestamp"] },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "page": { "type": "integer", "minimum": 1 },
        "speaker": { "type": "string" },
        "quoted_text": { "type": "string" },
        "release_level": { "$ref": "#/$defs/releaseLevel" },
        "review_state": { "$ref": "#/$defs/reviewState" }
      }
    },
    "claimInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "text", "claim_kind", "source_span_ids", "release_level", "review_state", "provenance"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "claim_kind": { "type": "string", "enum": ["statement", "premise", "inference", "conclusion", "evidence", "objection", "rebuttal", "critique", "summary", "question", "other"] },
        "source_span_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "canonical_claim_ref_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "release_level": { "$ref": "#/$defs/releaseLevel" },
        "review_state": { "$ref": "#/$defs/reviewState" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "canonicalClaimReference": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_claim_ref_id", "namespace", "key", "match_status", "release_level", "review_state"],
      "properties": {
        "canonical_claim_ref_id": { "$ref": "#/$defs/id" }, "namespace": { "type": "string", "minLength": 1 }, "key": { "type": "string", "minLength": 1 }, "label": { "type": "string" },
        "match_status": { "type": "string", "enum": ["candidate", "accepted", "rejected", "unresolved"] }, "release_level": { "$ref": "#/$defs/releaseLevel" }, "review_state": { "$ref": "#/$defs/reviewState" }
      }
    },
    "argumentRelation": {
      "type": "object", "additionalProperties": false,
      "required": ["relation_id", "from_claim_id", "to_claim_id", "relation_type", "release_level", "review_state"],
      "properties": {
        "relation_id": { "$ref": "#/$defs/id" }, "from_claim_id": { "$ref": "#/$defs/id" }, "to_claim_id": { "$ref": "#/$defs/id" }, "relation_type": { "type": "string", "enum": ["supports", "opposes", "entails", "qualifies", "depends_on", "responds_to", "contradicts", "illustrates", "other"] }, "release_level": { "$ref": "#/$defs/releaseLevel" }, "review_state": { "$ref": "#/$defs/reviewState" }, "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "citationAssertion": {
      "type": "object", "additionalProperties": false,
      "required": ["citation_assertion_id", "claim_id", "target_source_id", "assertion_type", "support_status", "release_level", "review_state"],
      "properties": {
        "citation_assertion_id": { "$ref": "#/$defs/id" }, "claim_id": { "$ref": "#/$defs/id" }, "target_source_id": { "$ref": "#/$defs/id" }, "target_span_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "assertion_type": { "type": "string", "enum": ["supports", "contradicts", "mentions", "background", "context"] }, "support_status": { "type": "string", "enum": ["claimed", "assessed", "supported", "partial", "not_supported", "unresolved"] }, "release_level": { "$ref": "#/$defs/releaseLevel" }, "review_state": { "$ref": "#/$defs/reviewState" }, "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "lineageCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["lineage_candidate_id", "from_document_id", "to_document_id", "lineage_type", "evidence_span_ids", "confidence", "release_level", "review_state"],
      "properties": {
        "lineage_candidate_id": { "$ref": "#/$defs/id" }, "from_document_id": { "$ref": "#/$defs/id" }, "to_document_id": { "$ref": "#/$defs/id" }, "lineage_type": { "type": "string", "enum": ["explicit_citation", "quotation", "paraphrase", "shared_phrase", "shared_argument", "silent_borrowing", "independent_recurrence", "other"] }, "evidence_span_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "release_level": { "$ref": "#/$defs/releaseLevel" }, "review_state": { "$ref": "#/$defs/reviewState" }, "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "coverageAudit": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage_audit_id", "scope", "expected_span_ids", "covered_claim_ids", "status", "gaps", "release_level", "review_state"],
      "properties": {
        "coverage_audit_id": { "$ref": "#/$defs/id" }, "scope": { "type": "string", "minLength": 1 }, "expected_span_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "covered_claim_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "status": { "type": "string", "enum": ["complete", "partial", "not_started"] }, "gaps": { "type": "array", "items": { "type": "string" } }, "release_level": { "$ref": "#/$defs/releaseLevel" }, "review_state": { "$ref": "#/$defs/reviewState" }
      }
    },
    "reviewReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "subject_type", "subject_id", "reviewer_role", "decision", "checked_at", "checks", "release_level", "review_state"],
      "properties": {
        "receipt_id": { "$ref": "#/$defs/id" }, "subject_type": { "type": "string", "enum": ["source", "document", "version", "span", "claim", "canonical_claim_reference", "argument_relation", "citation_assertion", "lineage_candidate", "coverage_audit", "knowledge_basis_manifest"] }, "subject_id": { "$ref": "#/$defs/id" }, "reviewer_role": { "type": "string", "minLength": 1 }, "decision": { "type": "string", "enum": ["accept", "revise", "reject", "defer"] }, "checked_at": { "$ref": "#/$defs/dateTime" }, "checks": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "notes": { "type": "string" }, "release_level": { "$ref": "#/$defs/releaseLevel" }, "review_state": { "$ref": "#/$defs/reviewState" }
      }
    },
    "knowledgeBasisManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "source_ids", "claim_ids", "coverage_audit_ids", "completeness", "release_level", "review_state"],
      "properties": {
        "manifest_id": { "$ref": "#/$defs/id" }, "source_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "claim_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "coverage_audit_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "completeness": { "type": "string", "enum": ["complete", "partial", "unknown"] }, "basis_note": { "type": "string" }, "release_level": { "$ref": "#/$defs/releaseLevel" }, "review_state": { "$ref": "#/$defs/reviewState" }
      }
    }
  }
}
